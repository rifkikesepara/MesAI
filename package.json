{
  "name": "mesai",
  "productName": "MesAI",
  "version": "1.0.1",
  "description": "MesAI (DevTrack AI) — Kanıta Dayalı Günlük Çalışma Raporu ve Aktivite Takip Uygulaması",
  "author": "Rıfkı Kesepara",
  "main": "dist-main/src/main/index.js",
  "scripts": {
    "version:sync": "node scripts/sync-version.js",
    "prebuild": "node scripts/sync-version.js",
    "prestart": "node scripts/sync-version.js",
    "build:reader": "dotnet build readers/ZoomChatReader/ZoomChatReader.csproj -c Release",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:reader && npm run build:main && npm run build:renderer",
    "dev:renderer": "vite --port 5173",
    "start": "npm run build:main && npm run build:renderer && electron .",
    "test": "npm run build:reader && npm run build:main && node --test dist-main/tests/*.test.js",
    "pack:dir": "npm run build && electron-builder --dir",
    "pack:win": "npm run build && electron-builder --win",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rifkikesepara/MesAI.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
